{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "MoonUP Seller API",
  "colors": {
    "primary": "#2a795f",
    "light": "#67b09c",
    "dark": "#2a795f"
  },
  "favicon": "/favicon.png",
  "logo": {
    "light": "/logo/moonup.webp",
    "dark": "/logo/moonup.webp",
    "href": "https://moonup.gg"
  },
  "appearance": {
    "default": "dark",
    "strict": true
  },
  "fonts": {
    "family": "Golos Text"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "index",
              "authentication"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "openapi": "openapi.yaml",
        "groups": [
          {
            "group": "Catalog",
            "pages": [
              "GET /v1/offers/games",
              "GET /v1/offers/games/{game}/categories",
              "GET /v1/offers/games/{game}/categories/{category_slug}/schema",
              "GET /v1/offers/games/{game}/categories/{category_slug}/products",
              "GET /v1/offers/games/{game_id}/catalog/{attribute_key}",
              "GET /v1/offers/delivery-methods"
            ]
          },
          {
