{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "MoonUP Docs",
  "colors": {
    "primary": "#2a795f",
    "light": "#67b09c",
    "dark": "#2a795f"
  },
  "favicon": "/favicon.png",
  "logo": {
    "light": "/logo/moonup.webp",
    "dark": "/logo/moonup.webp",
    "href": "https://moonup.gg"
  },
  "appearance": {
    "default": "dark",
    "strict": true
  },
  "background": {
    "color": {
      "dark": "#040611",
      "light": "#040611"
    }
  },
  "fonts": {
    "family": "Golos Text"
  },
  "navigation": {
    "interaction": {
      "drilldown": false
    },
    "languages": [
      {
        "language": "en",
        "default": true,
        "tabs": [
          {
            "tab": "Help Center",
            "groups": [
              {
                "group": "Sections",
                "pages": [
                  "en/help/buying",
                  "en/help/currency",
                  "en/help/boosting",
                  "en/help/payments",
                  "en/help/trust-safety"
                ]
              }
            ]
          },
